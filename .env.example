# Database Configuration
# PostgreSQL connection URL
DB_URL=jdbc:postgresql://localhost:5432/cashflowdb

# Database username
DB_USERNAME=postgres

# Database password (NEVER commit real credentials)
DB_PASSWORD=your_secure_password_here

# Backend Server Port
PORT=8080

# Frontend URL for CORS (must match where frontend is deployed)
FRONTEND_URL=http://localhost:5173

# Google API Key for AI features (optional - leave blank if not using AI features)
GOOGLE_API_KEY=your_google_api_key_here
